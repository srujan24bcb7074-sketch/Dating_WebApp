# Supabase Public Keys (Client Side)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Private Service Role Key (Server Side ONLY - Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# External AI LLM API Key (OpenRouter, Google Gemini, or OpenAI)
# For OpenRouter:
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=google/gemini-2.5-flash  (or openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, etc.)
# If left blank, the app will automatically use its internal high-quality AI Fallback Generator for zero-downtime testing!
AI_API_KEY=your_ai_api_key_here
AI_MODEL=google/gemini-2.5-flash

